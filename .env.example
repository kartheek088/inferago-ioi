# Inferago IOI configuration. Copy to .env (never commit .env).

# --- Server ---------------------------------------------------------------------------------
IOI_HOST=127.0.0.1
IOI_PORT=8000
# Shared bearer token. REQUIRED if IOI_HOST is not a loopback address (server refuses to start otherwise).
# Without a token, the API only accepts requests from 127.0.0.1 / ::1.
IOI_API_TOKEN=
IOI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (SQLite for V1) ---------------------------------------------------------------
# Default: backend/data/ioi.db
# IOI_DATABASE_URL=sqlite:////absolute/path/to/ioi.db

# --- Scheduler (opt-in) ---------------------------------------------------------------------
IOI_SCHEDULER_ENABLED=false

# --- Outbound HTTP limits -------------------------------------------------------------------
IOI_HTTP_TIMEOUT_SECONDS=15
IOI_HTTP_MAX_BYTES=5242880

# --- Optional Claude (Anthropic API) — preferred AI provider when set ----------------------
# Enables the Claude review agent (retrieve → verify → eligibility opinion) and uses Claude for
# every other AI task too. Get a key at https://console.anthropic.com/ .
IOI_ANTHROPIC_API_KEY=
IOI_ANTHROPIC_MODEL=claude-opus-5-5
IOI_ANTHROPIC_EFFORT=medium
IOI_AGENT_MAX_FETCHES=6
IOI_AGENT_MAX_ITERATIONS=14

# --- Optional AI via OpenRouter (the app runs fully without these) --------------------------
# Choose a model you have access to; no model is assumed to be free or available.
IOI_OPENROUTER_API_KEY=
IOI_OPENROUTER_MODEL=

# --- Optional Reddit official API (adapter stays disabled without all three) ---------------
IOI_REDDIT_CLIENT_ID=
IOI_REDDIT_CLIENT_SECRET=
IOI_REDDIT_USER_AGENT=
